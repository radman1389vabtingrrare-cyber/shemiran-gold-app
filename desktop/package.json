{
  "name": "shemiran-gold-desktop",
  "productName": "Shemiran Gold",
  "version": "1.0.0",
  "private": true,
  "description": "برنامه‌ی ویندوز شمیران گلد (Electron): داشبورد سایت داخل یک پنجره‌ی نصبی",
  "author": "Shemiran Gold",
  "main": "main.js",
  "scripts": {
    "start": "node ../scripts/sync-shared.mjs && electron .",
    "dist": "node ../scripts/sync-shared.mjs && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "ir.shemirangold.app",
    "productName": "Shemiran Gold",
    "copyright": "Shemiran Gold",
    "directories": {
      "output": "../dist/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "app/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "shemiran-gold.${ext}",
      "signAndEditExecutable": false
    },
    "afterPack": "build/after-pack.js",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "شمیران گلد"
    }
  }
}